# Host GPU index exposed to the single vLLM container.
FINLLM_GPU_DEVICE_ID=1

# Preloaded Hugging Face cache. The pinned model revision must already exist.
# Runtime network access is disabled with HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE.
FINLLM_HF_CACHE_DIR=/absolute/path/to/.cache/huggingface

# Loopback-only host ports. Containers use their internal service names.
FINLLM_API_PORT=8080
FINLLM_VLLM_PORT=8000

# Optional Hugging Face token file. Keep the token itself out of this file.
# FINLLM_HF_TOKEN_FILE=/absolute/path/to/hf-token

# These are operational policies, not measured performance claims.
FINLLM_SHUTDOWN_TIMEOUT_SECONDS=30
FINLLM_API_STOP_GRACE_PERIOD=40s
FINLLM_VLLM_START_PERIOD=15m
FINLLM_VLLM_STOP_GRACE_PERIOD=2m
FINLLM_VLLM_SHM_SIZE=16gb

# Filled from the immutable release commit and built API image digest.
FINLLM_GIT_SHA=NOT_PROVIDED
FINLLM_IMAGE_DIGEST=NOT_PROVIDED
